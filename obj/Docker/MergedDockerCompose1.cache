name: dockercompose9473298116648543939
services:
  threebook:
    build:
      context: C:\Users\Pizza\Documents\GitHub\BibleThreeTable\ThreeBook
      dockerfile: Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
        source: obj/Docker/empty/
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: ThreeBook
    entrypoint:
    - cmd
    - /c
    - start /B C:\ServiceMonitor.exe w3svc & C:\remote_debugger\x64\msvsmon.exe /noauth
      /anyuser /silent /nostatus /noclrwarn /nosecuritywarn /nofirewallwarn /nowowwarn
      /timeout:2147483646
    image: threebook:dev
    networks:
      default: null
    ports:
    - mode: ingress
      target: 80
      protocol: tcp
    volumes:
    - type: bind
      source: C:\Users\Pizza\Documents\GitHub\BibleThreeTable\ThreeBook
      target: C:\inetpub\wwwroot
      bind:
        create_host_path: true
    - type: bind
      source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\Remote
        Debugger
      target: C:\remote_debugger
      read_only: true
      bind:
        create_host_path: true
networks:
  default:
    name: dockercompose9473298116648543939_default